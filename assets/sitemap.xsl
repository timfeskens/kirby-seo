<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  exclude-result-prefixes="sm xhtml">
  <xsl:output method="html" encoding="UTF-8" indent="yes"/>
  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>XML Sitemap</title>
        <style>
          :root { color-scheme: light dark; font-family: system-ui, sans-serif; background: #f4f6f8; color: #18232e; }
          * { box-sizing: border-box; }
          body { margin: 0; padding: clamp(1rem, 4vw, 3rem); }
          main { max-width: 72rem; margin: 0 auto; }
          header { margin-bottom: 2rem; }
          h1 { margin: 0 0 .75rem; font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -.04em; }
          p { line-height: 1.6; }
          .intro, footer { color: #526171; }
          .count { display: inline-block; margin: 0; padding: .35rem .75rem; border-radius: 2rem; background: #e2eaf2; font-size: .875rem; font-weight: 600; }
          table { width: 100%; border-collapse: collapse; table-layout: fixed; background: #fff; }
          th, td { padding: 1rem; text-align: left; vertical-align: top; border-bottom: 1px solid #dce3ea; }
          th { font-size: .8rem; color: #526171; }
          th:last-child { width: 16rem; }
          a { color: #155ba0; text-underline-offset: .2em; overflow-wrap: anywhere; }
          a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
          time { font-size: .875rem; overflow-wrap: anywhere; }
          time span { display: block; }
          .clock { margin-top: .25rem; color: #526171; font-size: .75rem; }
          .alternates { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; font-size: .8rem; }
          .empty { padding: 1.5rem; border: 1px dashed #9aa8b5; border-radius: .5rem; }
          footer { margin-top: 1.5rem; font-size: .8rem; }
          @media (max-width: 40rem) {
            th, td { padding: .75rem; }
            th:last-child { width: 35%; }
          }
          @media (prefers-color-scheme: dark) {
            :root { background: #121a22; color: #e5edf5; }
            table { background: #1b2733; }
            th, td { border-color: #364554; }
            .intro, footer, th, .clock { color: #adbdcd; }
            .count { background: #2b3d4e; }
            a { color: #95caff; }
          }
        </style>
      </head>
      <body>
        <main>
          <header>
            <h1>XML Sitemap</h1>
            <p class="intro">This sitemap lists the URLs offered to search engines. This readable view does not change the underlying XML.</p>
            <p class="count"><xsl:value-of select="count(sm:urlset/sm:url)"/> URLs</p>
          </header>
          <xsl:choose>
            <xsl:when test="sm:urlset/sm:url">
              <table>
                <caption style="position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden">Sitemap URLs and last modification dates</caption>
                <thead><tr><th scope="col">URL</th><th scope="col">Last modified</th></tr></thead>
                <tbody>
                  <xsl:for-each select="sm:urlset/sm:url">
                    <tr>
                      <td>
                        <a href="{sm:loc}"><xsl:value-of select="sm:loc"/></a>
                        <xsl:if test="xhtml:link[@rel='alternate']">
                          <div class="alternates" aria-label="Language alternatives">
                            <xsl:for-each select="xhtml:link[@rel='alternate']">
                              <a href="{@href}" hreflang="{@hreflang}"><xsl:value-of select="@hreflang"/></a>
                            </xsl:for-each>
                          </div>
                        </xsl:if>
                      </td>
                      <td>
                        <xsl:choose>
                          <xsl:when test="sm:lastmod"><time datetime="{sm:lastmod}"><span><xsl:value-of select="substring(sm:lastmod, 1, 10)"/></span><span class="clock"><xsl:value-of select="substring(sm:lastmod, 12, 8)"/><br/><xsl:value-of select="substring(sm:lastmod, 20)"/></span></time></xsl:when>
                          <xsl:otherwise>Not available</xsl:otherwise>
                        </xsl:choose>
                      </td>
                    </tr>
                  </xsl:for-each>
                </tbody>
              </table>
            </xsl:when>
            <xsl:otherwise><p class="empty">No indexable URLs are currently included.</p></xsl:otherwise>
          </xsl:choose>
          <footer><p>Generated by Kirby SEO · timfeskens/kirby-seo</p></footer>
        </main>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
